# Database Configuration
DB_NAME=good_shopping_db
DB_PORT=5432
DB_USERNAME=shopuser
DB_PASSWORD=your_secure_db_password_here

# Mail Server Configuration (e.g., Mailhog for local development)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
MAIL_FROM=no-reply@goodshopping.local

# Google OAuth Integration (Public Client ID for OAuth flow)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# JSON Web Tokens (JWT) Configuration
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Admin Account Seed (For seeding local dev db)
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@goodshopping.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Object Storage Configuration (AWS S3 or MinIO)
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=your_aws_or_minio_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_minio_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=ecoapi-goodshopping-images

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SECRET=your_paypal_sandbox_secret

# Frontend Configuration
FRONTEND_BASE_PORT=4200
